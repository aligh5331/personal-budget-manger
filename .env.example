# Copy to .env and fill in. All configuration comes from these variables.

# Required
BALE_BOT_TOKEN=
OWNER_BALE_ID=

# Metis key for the extraction LLM and Jev
LLM_API_KEY=

# Webhook mode: public base URL and a secret path of 32+ characters.
# The webhook is served at WEBHOOK_URL/bale/WEBHOOK_SECRET_PATH.
WEBHOOK_URL=
WEBHOOK_SECRET_PATH=

# polling or webhook; used only until /mode stores a choice. Empty means polling.
MODE_DEFAULT=

# compose.example.yml pins these two to :8080 and /data inside the container.
LISTEN_ADDR=:8080
DATA_DIR=./data
TZ_REPORTS=Asia/Tehran
